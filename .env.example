# MySQL local. La base "kitch" se crea sola al correr npm start (migraciones).
#   macOS (Homebrew):      mysql://root:TU_PASSWORD@localhost:3306/kitch
#   Windows (XAMPP):       mysql://root@localhost:3306/kitch   (root sin contraseña)
#   Windows (MySQL 8):     mysql://root:TU_PASSWORD@localhost:3306/kitch
DATABASE_URL="mysql://USUARIO:PASSWORD@localhost:3306/kitch"
PORT=3000
TZ=America/Argentina/Buenos_Aires

# Firebase Emulator Suite (proyecto demo-*: no requiere cuenta ni credenciales reales)
FIREBASE_PROJECT_ID=demo-kitch
FIREBASE_STORAGE_BUCKET=demo-kitch.appspot.com
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
